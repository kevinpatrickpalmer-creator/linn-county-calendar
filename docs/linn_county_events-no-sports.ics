BEGIN:VEVENT
SUMMARY:Main Street Brookfield’s Sip & Stroll
DTSTART:20260919T223000Z
DTEND:20260920T003000Z
DTSTAMP:20260808T131601Z
UID:bfcity-main-street-brookfields-sip-stroll-2026-09-19-0530@linn-county-
 scraper.local
DESCRIPTION:On Saturday\, September 19\, from 5:30–7:30 PM\, attendee
